{
  "name": "dsh-office-tools",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "Local Excel, Word and PowerPoint editing through a bundled Office-MCP server, with DSH skills and downloadable files.",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "lib",
    "scripts",
    "data",
    "skills",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/averyjohnkucan-arch/dsh-office-tools.git"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-rc.2"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2"
  }
}
